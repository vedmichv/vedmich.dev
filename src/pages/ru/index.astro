---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LatestStrip from '../../components/LatestStrip.astro';
import BlogPreview from '../../components/BlogPreview.astro';
import Speaking from '../../components/Speaking.astro';
import About from '../../components/About.astro';
import Podcasts from '../../components/Podcasts.astro';
import Book from '../../components/Book.astro';
import Contact from '../../components/Contact.astro';
import { homePageJsonLd } from '../../lib/structured-data';

const locale = 'ru';
const description = 'Виктор Ведмич: Senior Solutions Architect в AWS, CNCF Kubestronaut, автор книги и спикер. Kubernetes, облачная архитектура и AI для DevOps.';
---

<BaseLayout
  title="Виктор Ведмич · Solutions Architect, автор, спикер"
  description={description}
  locale={locale}
  path="/"
  jsonLd={homePageJsonLd(Astro.site!, locale, description)}
>
  <Hero locale={locale} />
  <LatestStrip locale={locale} />
  <BlogPreview locale={locale} />
  <Speaking locale={locale} />
  <About locale={locale} />
  <Podcasts locale={locale} />
  <Book locale={locale} />
  <Contact locale={locale} />
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import { YouTube } from '@astro-community/astro-embed-youtube';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiblingTalks from '../../../components/SiblingTalks.astro';
import { t } from '../../../i18n/utils';
import { pageTitle, summarize } from '../../../lib/seo';
import { talkEventJsonLd } from '../../../lib/structured-data';
import { langOfText } from '../../../i18n/lang-of-parts';
import { videoPlatform } from '../../../lib/video';

export async function getStaticPaths() {
  const talks = await getCollection('speaking', ({ id }) => id.startsWith('ru/'));
  return talks.map((talk) => ({
    params: { slug: talk.id.replace('ru/', '') },
    props: { talk },
  }));
}

const { talk } = Astro.props;
const { Content } = await render(talk);
const locale = 'ru';
const i = t(locale);

// Meta description: whole sentences of the talk body, at most 155 characters, plain text.
const description = summarize(talk.body, `Доклад на ${talk.data.event}, ${talk.data.city}`);

const jsonLd = talkEventJsonLd({
  site: Astro.site!,
  locale,
  url: new URL(Astro.url.pathname, Astro.site).href,
  title: talk.data.title,
  description,
  event: talk.data.event,
  city: talk.data.city,
  date: talk.data.date,
  video: talk.data.video,
});

const video = talk.data.video ? videoPlatform(talk.data.video) : undefined;

// A `t=` timestamp in the video URL (e.g. &t=4500s) becomes the embed's start time.
const videoStart = talk.data.video
  ? new URL(talk.data.video).searchParams.get('t')?.replace(/s$/, '')
  : undefined;
---

<BaseLayout
  title={pageTitle(talk.data.title, locale)}
  description={description}
  locale={locale}
  noindex={talk.data.draft}
  jsonLd={jsonLd}
  path={`/speaking/${talk.id.replace('ru/', '')}`}
>
  <article class="max-w-3xl mx-auto px-6 py-20 sm:py-28">
    <a href={`/${locale}/speaking/`} class="text-sm text-brand-primary hover:text-brand-primary-hover transition-colors mb-4 inline-block">
      ← {i.speaking.back_link}
    </a>

    <h1 lang={langOfText(talk.data.title, locale)} class="font-display text-4xl break-words hyphens-auto font-bold text-text-primary mb-4">{talk.data.title}</h1>

    <p class="text-base font-medium text-text-secondary mb-6">
      {talk.data.event} · {talk.data.city} · {talk.data.date.toLocaleDateString('ru-RU', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </p>

    {talk.data.tags && talk.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-8" role="list">
        {talk.data.tags.map((tag) => (
          <span
            class="tag-chip"
            role="listitem"
          >
            {tag}
          </span>
        ))}
      </div>
    )}

    {talk.data.video && video?.embeddable && (
      <div class="mb-8">
        <YouTube id={talk.data.video} params={videoStart ? `start=${videoStart}` : undefined} />
      </div>
    )}

    {(talk.data.video || talk.data.slides || talk.data.post) && (
      <div class="flex flex-wrap gap-3 mb-8">
        {talk.data.video && (
          <a
            href={talk.data.video}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-brand-accent text-bg-base hover:bg-brand-accent-hover transition-colors font-semibold"
            aria-label={`${i.speaking.watch_on.replace('{platform}', video!.name)} (${i.contact.opens_in_new_tab})`}
          >
            {i.speaking.watch_on.replace('{platform}', video!.name)}
          </a>
        )}
        {talk.data.slides && (
          <a
            href={talk.data.slides}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border-2 border-brand-primary text-brand-primary hover:bg-brand-primary-soft transition-colors font-semibold"
            aria-label={`${i.speaking.view_slides} (${i.contact.opens_in_new_tab})`}
          >
            {i.speaking.view_slides}
          </a>
        )}
        {talk.data.post && (
          <a
            href={talk.data.post}
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg border-2 border-brand-primary text-brand-primary hover:bg-brand-primary-soft transition-colors font-semibold"
          >
            {i.speaking.read_article}
          </a>
        )}
      </div>
    )}

    <div class="prose prose-invert prose-lg max-w-none
      prose-headings:font-display prose-headings:font-semibold
      prose-a:text-brand-primary prose-a:no-underline hover:prose-a:underline
      prose-code:font-mono prose-code:text-brand-primary-hover
      prose-pre:bg-bg-code prose-pre:border prose-pre:border-border
    ">
      <Content />
    </div>
    <SiblingTalks locale={locale} talk={talk} />
  </article>
</BaseLayout>

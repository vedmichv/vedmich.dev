---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import LatestStrip from '../../components/LatestStrip.astro';
import BlogPreview from '../../components/BlogPreview.astro';
import Speaking from '../../components/Speaking.astro';
import About from '../../components/About.astro';
import AlsoBand from '../../components/AlsoBand.astro';
import Contact from '../../components/Contact.astro';
import { homePageJsonLd } from '../../lib/structured-data';

const locale = 'en';
const description = 'Viktor Vedmich: Senior Solutions Architect @ AWS, CNCF Kubestronaut, Author, Speaker';
---

<BaseLayout
  title="Viktor Vedmich · Solutions Architect, Author, Speaker"
  description={description}
  locale={locale}
  path="/"
  jsonLd={homePageJsonLd(Astro.site!, locale, description)}
>
  <Hero locale={locale} />
  <LatestStrip locale={locale} />
  <BlogPreview locale={locale} />
  <Speaking locale={locale} />
  <About locale={locale} />
  <AlsoBand locale={locale} />
  <Contact locale={locale} />
</BaseLayout>

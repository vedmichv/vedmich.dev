---
// Root 404 page → emitted by Astro as dist/404.html.
//
// GitHub Pages serves THIS file (the site-wide custom 404) for ANY unmatched
// path on the custom domain — including deep-links under a published Slidev
// deck, e.g. /slides/<slug>/10 or /slides/<slug>/presenter/3.
//
// WHY THIS IS NEEDED (verified 2026-06, Slidev 52.x):
//   The decks live at /slides/<slug>/ (copied by deploy.yml into dist/slides/).
//   Slidev v52 uses PATH-based slide routing: slide N is the URL
//   /slides/<slug>/N, and the SPA router reads the slide number from the URL
//   PATH AT BOOT. The deck root /slides/<slug>/ is a real file (HTTP 200), but
//   /slides/<slug>/10 is NOT a file on disk → GitHub Pages returns its built-in
//   "Page not found" page. The deck's own dist/slides/<slug>/404.html is never
//   served for that path (Pages does not do per-directory 404 fallback on this
//   custom-domain topology), and the deck's _redirects file is Netlify-only —
//   GitHub Pages ignores it.
//
// THE FIX (empirically validated against the live deck with Playwright):
//   For a /slides/<slug>/<rest> miss, fetch the deck's index.html shell and swap
//   it into THIS document WITHOUT changing location. Because the URL stays at
//   /slides/<slug>/10, Slidev's path router boots straight onto slide 10.
//   - Tried & rejected: location.replace('/slides/<slug>/10') → 404 loop (the
//     path is still not a file).  ?p=/N and #N → Slidev v52 normalises to /1
//     (lands on slide 1, not N).  Document-injection is the only form that lands
//     on the correct slide AND keeps the clean /N URL.
//
// Other misses retain their URL and show a recovery page with both locales.
// Paths under /ru/ swap the text to Russian and set lang="ru" (the markup is
// English, each translated node carries its Russian text in data-ru).
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found | Viktor Vedmich</title>
    <script is:inline>
      (function () {
        var path = window.location.pathname;
        // Deep-link under a Slidev deck: /slides/<slug>/<rest>
        // (<rest> = slide number, or presenter/N, overview, etc.)
        var m = path.match(/^\/slides\/([^/]+)\/(.+)$/);
        if (m) {
          var slug = m[1];
          // Boot the deck SPA in place. We keep `location` exactly as requested
          // (/slides/<slug>/<rest>) so Slidev's path router lands on the right
          // slide; we only swap in the deck's HTML shell so its bundle loads.
          fetch('/slides/' + slug + '/index.html', { credentials: 'same-origin' })
            .then(function (r) {
              if (!r.ok) throw new Error('deck shell ' + r.status);
              return r.text();
            })
            .then(function (html) {
              document.open();
              document.write(html);
              document.close();
            })
            .catch(function () {
              // Leave the recovery page visible when a deck is unavailable.
            });
          return;
        }
        // Non-deck misses keep the requested URL and the real 404 response.
        // Russian paths get Russian text, lang="ru" and the Russian links first.
        if (/^\/ru(\/|$)/.test(path)) {
          document.documentElement.lang = 'ru';
          document.title = 'Страница не найдена | Виктор Ведмич';
          var localize = function () {
            var nodes = document.querySelectorAll('[data-ru]');
            for (var k = 0; k < nodes.length; k++) {
              nodes[k].textContent = nodes[k].getAttribute('data-ru');
            }
            var group = document.querySelector('[data-nav-group]');
            var ruNav = group && group.querySelector('nav[lang="ru"]');
            if (ruNav) group.insertBefore(ruNav, group.firstChild);
          };
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', localize);
          } else {
            localize();
          }
        }
      })();
    </script>
  </head>
  <body class="min-h-screen grid place-items-center px-6">
    <main class="max-w-xl py-16">
      <p class="font-mono text-brand-primary mb-4">404</p>
      <h1 class="font-display text-4xl font-bold mb-4" data-ru="Страница не найдена">Page not found</h1>
      <p class="text-text-secondary mb-8" data-ru="Ссылка могла устареть, или страницы ещё нет.">This link may have moved or the page may not be published yet.</p>
      <div class="flex flex-col gap-3" data-nav-group>
        <nav aria-label="English" lang="en" class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
          <span class="font-mono text-sm text-text-muted w-20">English</span>
          <a href="/en/" class="text-brand-primary hover:underline py-1">Home</a>
          <a href="/en/blog/" class="text-brand-primary hover:underline py-1">Blog</a>
          <a href="/en/speaking/" class="text-brand-primary hover:underline py-1">Talks</a>
        </nav>
        <nav aria-label="Русский" lang="ru" class="flex flex-wrap items-baseline gap-x-5 gap-y-1">
          <span class="font-mono text-sm text-text-muted w-20">Русский</span>
          <a href="/ru/" class="text-brand-primary hover:underline py-1">Главная</a>
          <a href="/ru/blog/" class="text-brand-primary hover:underline py-1">Блог</a>
          <a href="/ru/speaking/" class="text-brand-primary hover:underline py-1">Выступления</a>
        </nav>
      </div>
    </main>
  </body>
</html>

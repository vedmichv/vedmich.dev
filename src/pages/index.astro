---
// Root page: auto-detect language and redirect
// For static builds, we output an HTML page with client-side detection
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Viktor Vedmich · Solutions Architect, Author, Speaker</title>
    <!-- Scrapers do not run the redirect script, so the root carries the /en/ metadata. -->
    <meta name="description" content="Viktor Vedmich: Senior Solutions Architect @ AWS, CNCF Kubestronaut, Author, Speaker" />
    <link rel="canonical" href="https://vedmich.dev/en/" />
    <link rel="alternate" hreflang="en" href="https://vedmich.dev/en/" />
    <link rel="alternate" hreflang="ru" href="https://vedmich.dev/ru/" />
    <link rel="alternate" hreflang="x-default" href="https://vedmich.dev/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vedmich.dev/en/" />
    <meta property="og:title" content="Viktor Vedmich · Solutions Architect, Author, Speaker" />
    <meta property="og:description" content="Viktor Vedmich: Senior Solutions Architect @ AWS, CNCF Kubestronaut, Author, Speaker" />
    <meta property="og:image" content="https://vedmich.dev/og-default.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function() {
        // Check if user has a stored preference
        var saved;
        try { saved = localStorage.getItem('vedmich-lang'); } catch (_) {}
        if (saved === 'ru' || saved === 'en') {
          window.location.replace('/' + saved + '/');
          return;
        }

        // Auto-detect from browser language
        var lang = (navigator.language || navigator.userLanguage || 'en').toLowerCase();
        var target = (lang.startsWith('ru') || lang.startsWith('be') || lang.startsWith('uk')) ? 'ru' : 'en';

        // Save preference and redirect
        try { localStorage.setItem('vedmich-lang', target); } catch (_) {}
        window.location.replace('/' + target + '/');
      })();
    </script>
    <!-- Fallback for no-JS -->
    <noscript>
      <meta http-equiv="refresh" content="0;url=/en/" />
    </noscript>
  </head>
  <body style="background:#0F172A;color:#94A3B8;display:flex;align-items:center;justify-content:center;min-height:100vh;font-family:system-ui;">
    <p>Redirecting...</p>
  </body>
</html>

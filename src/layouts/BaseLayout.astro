---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPalette from '../components/SearchPalette.astro';
import { getCollection } from 'astro:content';
import { type Locale, getAlternateLocale, getLocalizedPath, t } from '../i18n/utils';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  path?: string;
  image?: string;
  articleDate?: Date;
  /** Unlisted pages (e.g. draft blog posts): emit <meta robots="noindex"> so the
   *  public direct link is not indexed by search engines until it is promoted. */
  noindex?: boolean;
}

const { title, description = 'Viktor Vedmich — Senior Solutions Architect @ AWS, CNCF Kubestronaut, Author, Speaker', locale, path = '', noindex = false } = Astro.props;
const altLocale = getAlternateLocale(locale);
const i = t(locale);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const normalizedPath = path.replace(/\/$/, '');
const detail = normalizedPath.match(/^\/(blog|speaking)\/(.+)$/);
let hasTranslation = true;
if (detail) {
  const entries = await getCollection(detail[1] as 'blog' | 'speaking');
  hasTranslation = entries.some((entry) => entry.id === `${altLocale}/${detail[2]}` && !entry.data.draft);
}
const altPath = getLocalizedPath(`${normalizedPath}/`, altLocale);
const altURL = new URL(altPath, Astro.site);
const switchPath = hasTranslation ? altPath : `/${altLocale}/${detail?.[1] || ''}/`;
const imageURL = new URL(Astro.props.image || '/og-default.png', Astro.site);
---

<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalURL} />
    {!noindex && hasTranslation && <link rel="alternate" hreflang={altLocale} href={altURL} />}
    {!noindex && <link rel="alternate" hreflang={locale} href={canonicalURL} />}

    <!-- Icons + PWA manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#14B8A6" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts: self-hosted from /public/fonts/ via design-tokens.css (@font-face) -->
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <noscript>
      <style>
        .animate-on-scroll { opacity: 1 !important; }
      </style>
    </noscript>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={Astro.props.articleDate ? 'article' : 'website'} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:alt" content={Astro.props.image ? title : 'Viktor Vedmich: Architect, Author, Speaker'} />
    {!Astro.props.image && <meta property="og:image:width" content="1200" />}
    {!Astro.props.image && <meta property="og:image:height" content="630" />}
    {Astro.props.articleDate && <meta property="article:published_time" content={Astro.props.articleDate.toISOString()} />}
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ru_RU'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@vedmichv" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={Astro.props.image ? title : 'Viktor Vedmich: Architect, Author, Speaker'} />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">{i.nav.skip_to_content}</a>
    <Header locale={locale} alternatePath={switchPath} />
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />

    <!-- Singleton toast for CodeCopyEnhancer (D-07b). One per page, hidden until
         a copy action sets text + .is-visible. Screen-reader polite announcement.
         MUST be hidden via opacity:0 (NOT display:none / visibility:hidden /
         aria-hidden) — those remove the element from the AT tree, silencing
         aria-live announcements. See RESEARCH.md §Q6. -->
    <div
      id="code-copy-toast"
      class="code-copy-toast"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <script>
      // Scroll-triggered animations — skipped when user prefers reduced motion.
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        document.querySelectorAll('.animate-on-scroll').forEach((el) => {
          el.classList.add('is-visible');
        });
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 }
        );

        document.querySelectorAll('.animate-on-scroll').forEach((el) => {
          observer.observe(el);
        });
      }
    </script>

    <!-- Global ⌘K search palette. Hidden by default; Header buttons or keyboard shortcuts open it. -->
    <SearchPalette locale={locale} />
  </body>
</html>

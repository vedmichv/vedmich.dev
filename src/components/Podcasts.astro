---
import { t, type Locale } from '../i18n/utils';
import { langOfText } from '../i18n/lang-of-parts';
import PodcastLinks from './PodcastLinks.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<!-- Rendered inside AlsoBand, which owns the band background, padding and container. -->
<section id="podcasts" aria-labelledby="podcasts-title" class="min-w-0">
  <div>
    <h2 id="podcasts-title" class="section-title mb-10 animate-on-scroll">{i.podcasts.title}</h2>

    <div class="grid md:grid-cols-2 gap-5">
      <!-- DKT card: PNG logo in badge slot per D-01, D-15. Not a link itself: the platform row holds the links. -->
      <article aria-labelledby="podcast-dkt-title" class="p-6 rounded-xl bg-surface border border-border animate-on-scroll">
        <div class="w-14 h-14 shrink-0 rounded-xl bg-white/95 p-1 flex items-center justify-center ring-1 ring-border">
          <img
            src="/images/dkt-logo.png"
            alt="DevOps Kitchen Talks logo"
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-contain"
          />
        </div>
        <h3 id="podcast-dkt-title" lang={langOfText(i.podcasts.dkt_name, locale)} class="font-display text-[22px] font-semibold text-text-primary mt-3 mb-2">
          {i.podcasts.dkt_name}
        </h3>
        <p class="font-body text-[15px] text-text-muted leading-relaxed">
          {i.podcasts.dkt_desc}
        </p>
        <div class="font-mono text-xs text-text-muted mt-4">
          {i.podcasts.dkt_stats}
        </div>
        <PodcastLinks locale={locale} show="dkt" />
      </article>

      <!-- AWS RU card: inline amber text badge per D-02, D-06, D-14 -->
      <article aria-labelledby="podcast-aws-title" class="p-6 rounded-xl bg-surface border border-border animate-on-scroll">
        <span class="inline-block font-body text-[11px] font-semibold uppercase tracking-[0.08em] px-2 py-1 rounded text-brand-accent bg-brand-accent-soft border border-brand-accent/40">
          AWS RU
        </span>
        <h3 id="podcast-aws-title" lang={langOfText(i.podcasts.aws_name, locale)} class="font-display text-[22px] font-semibold text-text-primary mt-3 mb-2">
          {i.podcasts.aws_name}
        </h3>
        <p class="font-body text-[15px] text-text-muted leading-relaxed">
          {i.podcasts.aws_desc}
        </p>
        <div class="font-mono text-xs text-text-muted mt-4">
          {i.podcasts.aws_stats}
        </div>
        <PodcastLinks locale={locale} show="aws" />
      </article>
    </div>
  </div>
</section>

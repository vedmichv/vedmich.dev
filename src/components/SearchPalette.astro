---
import { t, type Locale } from '../i18n/utils';
import { buildSearchIndex } from '../data/search-index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const index = await buildSearchIndex(locale);
const sortedIndex = [...index].sort((a, b) => b.date.localeCompare(a.date));
---

<script type="application/json" id="search-index-data" set:html={JSON.stringify(sortedIndex).replace(/</g, '\\u003c')} />

<dialog
  id="search-palette"
  class="fixed inset-0 m-0 w-full max-w-none h-dvh max-h-none border-0 items-start justify-center bg-transparent text-text-primary"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-palette-label"
  data-locale={locale}
  data-i18n-no-results={i.search.no_results}
  data-i18n-kind-slides={i.search.kind_slides}
  data-i18n-kind-post={i.search.kind_post}
  data-i18n-kind-talk={i.search.kind_talk}
  data-i18n-kind-page={i.search.kind_page}
  data-i18n-empty-hint={i.search.empty_hint}
  data-i18n-results-count={i.search.results_count}
>
  <div
    id="search-palette-card"
    class="w-full max-w-[640px] mx-4 flex flex-col min-h-0 bg-bg-surface border border-border rounded-[14px] overflow-hidden"
    style="box-shadow: 0 24px 60px rgba(0,0,0,0.5), 0 0 0 1px rgba(20,184,166,0.12);"
  >
    <h2 id="search-palette-label" class="sr-only">{i.nav.search_label}</h2>

    <div class="flex items-center gap-3 px-[18px] py-[14px] border-b border-border">
      <span aria-hidden="true" class="text-brand-primary font-mono text-base">⌕</span>
      <input
        id="search-palette-input"
        type="text"
        placeholder={i.search.placeholder}
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-label={i.nav.search_label}
        aria-controls="search-palette-results"
        aria-expanded="false"
        aria-autocomplete="list"
        class="flex-1 min-w-0 bg-transparent border-none outline-none font-sans text-base text-text-primary placeholder:text-text-muted"
      />
      <kbd class="font-mono text-[11px] text-text-muted bg-bg-base px-[7px] py-[3px] rounded border border-border">Esc</kbd>
    </div>

    <div id="search-palette-results" role="listbox" aria-label={i.nav.search_label} class="overflow-y-auto min-h-0" style="max-height: 380px;"></div>

    <div class="flex flex-wrap gap-2 shrink-0 items-center justify-between px-[18px] py-[10px] border-t border-border font-mono text-[11px] text-text-muted">
      <div class="flex gap-[14px]">
        <span class="inline-flex items-center gap-1">
          <kbd class="font-mono text-[10px] text-text-secondary px-[5px] py-[1px] rounded border border-border" style="background: rgba(148,163,184,0.08);">↑</kbd>
          <kbd class="font-mono text-[10px] text-text-secondary px-[5px] py-[1px] rounded border border-border" style="background: rgba(148,163,184,0.08);">↓</kbd>
          <span class="ml-1">{i.search.footer_move}</span>
        </span>
        <span class="inline-flex items-center gap-1">
          <kbd class="font-mono text-[10px] text-text-secondary px-[5px] py-[1px] rounded border border-border" style="background: rgba(148,163,184,0.08);">↵</kbd>
          <span class="ml-1">{i.search.footer_open}</span>
        </span>
      </div>
      <span id="search-palette-count" role="status" aria-live="polite"></span>
    </div>
  </div>
</dialog>

<style is:global>
  #search-palette {
    padding: min(96px, 10dvh) 0 16px;
  }
  #search-palette[open] {
    display: flex;
  }
  #search-palette::backdrop {
    background: rgb(2 6 23 / 0.72);
    backdrop-filter: blur(6px);
  }
  #search-palette-card {
    max-height: 100%;
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .search-result {
    display: grid;
    grid-template-columns: 74px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 14px 18px;
    cursor: pointer;
    border-left: 2px solid transparent;
    background: transparent;
  }
  .search-result.is-selected {
    background: rgba(20, 184, 166, 0.08);
    border-left-color: var(--brand-primary);
  }
  .search-result .kind-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    border: 1px solid;
    white-space: nowrap;
  }
  .search-result .kind-slides {
    color: var(--brand-primary-hover);
    background: rgba(20, 184, 166, 0.12);
    border-color: rgba(20, 184, 166, 0.3);
  }
  .search-result .kind-post {
    color: var(--brand-accent-hover);
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.3);
  }
  .search-result .kind-talk {
    color: var(--brand-primary-hover);
    background: transparent;
    border-color: var(--brand-primary);
  }
  .search-result .kind-page {
    color: var(--text-secondary);
    background: rgba(148, 163, 184, 0.08);
    border-color: var(--border-strong);
  }
  .search-result .title {
    font-family: var(--font-display);
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-result .sub {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-result .enter-arrow {
    font-family: var(--font-mono);
    font-size: 14px;
    color: var(--text-muted);
  }
</style>

<script>
  import { searchItems, type SearchItem, type SearchKind } from '../data/search-match';
  import { langOfText } from '../i18n/lang-of-parts';

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  const palette = document.getElementById('search-palette') as HTMLDialogElement | null;
  const card = document.getElementById('search-palette-card');
  const input = document.getElementById('search-palette-input') as HTMLInputElement | null;
  const resultsEl = document.getElementById('search-palette-results');
  const countEl = document.getElementById('search-palette-count');
  const indexEl = document.getElementById('search-index-data');

  if (palette && card && input && resultsEl && countEl && indexEl) {
    const index: SearchItem[] = JSON.parse(indexEl.textContent || '[]');
    const pageLocale = document.documentElement.lang === 'ru' ? 'ru' : 'en';
    let query = '';
    let selectedIndex = 0;
    let currentResults: SearchItem[] = [];
    let lastFocused: HTMLElement | null = null;

    const noResultsLabel = palette.getAttribute('data-i18n-no-results') || 'No matches for';
    const kindLabels: Record<SearchKind, string> = {
      slides: palette.getAttribute('data-i18n-kind-slides') || 'Slides',
      post: palette.getAttribute('data-i18n-kind-post') || 'Post',
      talk: palette.getAttribute('data-i18n-kind-talk') || 'Talk',
      page: palette.getAttribute('data-i18n-kind-page') || 'Page',
    };
    const countLabel = palette.getAttribute('data-i18n-results-count') || 'Results: {n} of {total}';

    function computeResults(q: string): SearchItem[] {
      if (!q.trim()) return index.slice(0, 6);
      return searchItems(q, index, 8);
    }

    function render() {
      currentResults = computeResults(query);
      if (selectedIndex >= currentResults.length) selectedIndex = 0;

      if (currentResults.length === 0) {
        resultsEl!.innerHTML = `
          <div style="padding: 32px; text-align: center; font-family: var(--font-body); color: var(--text-muted); font-size: 14px;">
            ${noResultsLabel} <span style="color: var(--text-primary);">&ldquo;${escapeHtml(query)}&rdquo;</span>.
          </div>
        `;
      } else {
        resultsEl!.innerHTML = currentResults
          .map((r, i) => {
            const isSelected = i === selectedIndex;
            const badgeLabel = kindLabels[r.kind] ?? r.kind;
            const badgeClass = `kind-${r.kind}`;
            const titleLang = langOfText(r.title, pageLocale);
            const titleLangAttr = titleLang ? ` lang="${titleLang}"` : '';
            return `
              <div id="search-result-${i}" class="search-result ${isSelected ? 'is-selected' : ''}" role="option" aria-selected="${isSelected}" data-idx="${i}">
                <span class="kind-badge ${badgeClass}">${escapeHtml(badgeLabel)}</span>
                <div style="min-width: 0;">
                  <div class="title"${titleLangAttr}>${escapeHtml(r.title)}</div>
                  <div class="sub">${escapeHtml(r.sub)}</div>
                </div>
                <span class="enter-arrow">↵</span>
              </div>
            `;
          })
          .join('');
      }

      const n = currentResults.length;
      const m = index.length;
      countEl!.textContent = countLabel.replace('{n}', String(n)).replace('{total}', String(m));
      if (n) input!.setAttribute('aria-activedescendant', `search-result-${selectedIndex}`);
      else input!.removeAttribute('aria-activedescendant');

      resultsEl!.querySelectorAll<HTMLElement>('.search-result').forEach((el) => {
        const idx = Number(el.dataset.idx);
        el.addEventListener('click', () => {
          if (currentResults[idx]) go(currentResults[idx]);
        });
        el.addEventListener('pointermove', () => {
          select(idx);
        });
      });
    }

    function select(idx: number, scroll = false) {
      selectedIndex = idx;
      resultsEl!.querySelectorAll<HTMLElement>('.search-result').forEach((el, i) => {
        el.classList.toggle('is-selected', i === idx);
        el.setAttribute('aria-selected', String(i === idx));
        if (i === idx && scroll) el.scrollIntoView({ block: 'nearest' });
      });
      if (currentResults.length) input!.setAttribute('aria-activedescendant', `search-result-${idx}`);
    }

    function go(item: SearchItem): void {
      if (item.kind === 'slides') {
        window.open(item.url, '_blank', 'noopener,noreferrer');
      } else {
        window.location.href = item.url;
      }
      close();
    }

    function open(): void {
      if (palette!.open) return;
      lastFocused = (document.activeElement as HTMLElement) || null;
      palette!.showModal();
      input!.setAttribute('aria-expanded', 'true');
      document.body.setAttribute('data-search-open', 'true');
      document.body.style.overflow = 'hidden';
      query = '';
      selectedIndex = 0;
      input!.value = '';
      render();
      input!.focus();
    }

    function close(): void {
      palette!.close();
      input!.setAttribute('aria-expanded', 'false');
      document.body.removeAttribute('data-search-open');
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') {
        lastFocused.focus();
      }
      // Opened with "/" from the page body: there is nothing to restore, and the hidden input
      // would stay the active element, which blocks the "/" shortcut until the next click.
      if (document.activeElement === input) input!.blur();    }

    document.addEventListener('vv:search:open', () => open());
    document.addEventListener('vv:search:close', () => close());

    input.addEventListener('input', (e) => {
      query = (e.target as HTMLInputElement).value;
      selectedIndex = 0;
      render();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        select(Math.min(selectedIndex + 1, Math.max(0, currentResults.length - 1)), true);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        select(Math.max(selectedIndex - 1, 0), true);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (currentResults[selectedIndex]) go(currentResults[selectedIndex]);
      }
    });

    palette.addEventListener('click', (e) => {
      if (e.target === palette) close();
    });

    palette.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });

    document.addEventListener('keydown', (e) => {
      const isOpen = palette!.open;
      const target = e.target as HTMLElement | null;
      const isEditable =
        !!target &&
        (target.tagName === 'INPUT' ||
          target.tagName === 'TEXTAREA' ||
          target.isContentEditable);

      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (isOpen) close();
        else open();
        return;
      }

      if (!isOpen && e.key === '/' && !isEditable) {
        e.preventDefault();
        open();
        return;
      }

      if (isOpen && e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    });
  }
</script>

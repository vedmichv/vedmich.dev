---
import { t, type Locale } from '../i18n/utils';
import { langOfText } from '../i18n/lang-of-parts';
import { bookLinks } from '../data/social';

// Hardcoded per D-17: Amazon has no public ratings API.
// Update manually when the Amazon listing rating changes meaningfully.
const rating = 4.8;

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
---

<section id="book" aria-labelledby="book-heading" class="py-20 sm:py-28 border-y border-brand-accent/30">
  <style>
    /* The cover image is already a 3D render (spine + perspective baked in).
       We only add a subtle hover lift + teal glow, no extra rotation. */
    .book-cover {
      display: block;
      height: auto;
      filter: drop-shadow(8px 14px 22px rgba(0, 0, 0, 0.45));
      transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1),
                  filter 400ms cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform;
    }
    .book-card:hover .book-cover,
    .book-card:focus-within .book-cover {
      transform: translateY(-6px);
      /* Teal glow tracks --brand-primary so palette migrations
         and the .light OG override flow through unchanged. */
      filter: drop-shadow(14px 24px 32px rgba(0, 0, 0, 0.55))
              drop-shadow(0 0 22px color-mix(in srgb, var(--brand-primary) 22%, transparent));
    }
    @media (prefers-reduced-motion: reduce) {
      .book-cover,
      .book-card:hover .book-cover,
      .book-card:focus-within .book-cover {
        transform: none;
        transition: none;
      }
    }
  </style>
  <div class="section-container">
    <h2 id="book-heading" class="section-title mb-12 animate-on-scroll">{i.book.title}</h2>

    <div class="animate-on-scroll">
      <article aria-labelledby="book-title" class="book-card p-6 sm:p-8 rounded-xl bg-bg border border-border">
        <div class="flex flex-col gap-6 sm:grid sm:grid-cols-[140px_1fr_auto] sm:gap-7 sm:items-center">
          <div class="book-cover-wrap flex justify-center sm:justify-start">
            <img
              src="/images/book-cover-3d.jpg"
              alt={i.book.cover_alt}
              width="200"
              height="247"
              loading="lazy"
              decoding="async"
              class="book-cover w-40 sm:w-48"
            />
          </div>

          <div>
            <h3 id="book-title" lang={langOfText(i.book.name, locale)} class="font-display text-xl font-semibold">
              {i.book.name}
            </h3>
            <div class="flex items-center gap-2 mt-2 mb-4" aria-label={i.book.rating_label.replace('{rating}', String(rating))}>
              <span class="text-brand-accent text-base" aria-hidden="true">★★★★★</span>
              <span class="font-mono text-sm text-text-secondary">{rating}</span>
              <span class="text-text-muted" aria-hidden="true">·</span>
              <span class="font-body text-sm text-text-muted">Amazon</span>
            </div>
            <p class="text-text-muted text-sm leading-relaxed">
              {i.book.desc}
            </p>
          </div>

          <div class="flex flex-col gap-3">
            <a
              href={bookLinks.amazon}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${i.book.cta} (${i.contact.opens_in_new_tab})`}
              class="group inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-brand-accent text-bg-base font-medium hover:bg-brand-accent-hover transition-colors"
            >
              {i.book.cta}
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
            <a
              href={bookLinks.packt}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${i.book.cta_packt} (${i.contact.opens_in_new_tab})`}
              class="group inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg border border-border text-text-primary font-medium hover:border-brand-accent hover:text-brand-accent-hover transition-colors"
            >
              {i.book.cta_packt}
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

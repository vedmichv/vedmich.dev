---
import { getCollection } from 'astro:content';
import { t, type Locale } from '../i18n/utils';
import TalkTimeline from './TalkTimeline.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);

// Query all speaking entries for current locale
const allTalks = await getCollection('speaking', ({ data, id }) => {
  return id.startsWith(`${locale}/`) && !data.draft;
});

// Sort by date descending
const talks = allTalks.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<section id="speaking" class="py-20 sm:py-28 bg-surface">
  <div class="section-container">
    <h2 class="section-title mb-2 animate-on-scroll">{i.speaking.title}</h2>
    <p class="text-text-muted mb-12 animate-on-scroll">{i.speaking.subtitle}</p>

    <TalkTimeline talks={talks} locale={locale} />

    <div class="mt-10 animate-on-scroll">
      <a href={`/${locale}/speaking/`} class="text-sm text-text-muted hover:text-brand-primary transition-colors whitespace-nowrap">
        {i.speaking.all_talks} →
      </a>
    </div>
  </div>
</section>

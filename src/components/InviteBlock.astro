---
/**
 * InviteBlock: the organizer path on /speaking/. Topics, formats and languages,
 * a mailto button with a prefilled subject, and a speaker kit (two bios per language,
 * copy buttons, photo download). Everything except the copy buttons works without JavaScript.
 * The mailto link is a local handoff to the visitor's mail app: nothing is sent from the page.
 */
import { t, type Locale } from '../i18n/utils';
import { contactEmail } from '../data/social';
import { speakerBios, speakerPhoto } from '../data/speaker-kit';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const inv = i.invite;

// Subject and body are encoded one by one so no value can add a header or a recipient.
const mailto =
  `mailto:${contactEmail}` +
  `?subject=${encodeURIComponent(inv.mail_subject)}` +
  `&body=${encodeURIComponent(inv.mail_body)}`;

const [ledeBefore, ledeAfter = ''] = inv.lede.split('{email}');

// The visitor's language first; both languages are always shown.
const otherLocale: Locale = locale === 'en' ? 'ru' : 'en';
const bioLangs = [locale, otherLocale].map((lang) => ({
  lang,
  language: lang === 'en' ? inv.lang_en : inv.lang_ru,
  bios: [
    { id: `bio-${lang}-short`, words: inv.bio_short, text: speakerBios[lang].short },
    { id: `bio-${lang}-long`, words: inv.bio_long, text: speakerBios[lang].long },
  ],
}));

const labelClass = 'font-body text-[11px] font-semibold uppercase tracking-[0.08em] text-text-secondary mb-3';
const pillClass =
  'inline-flex items-center rounded-full px-3.5 py-1.5 text-[13px] font-medium bg-bg-base border border-border text-text-primary';
const focusRing =
  'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-primary focus-visible:ring-offset-2 focus-visible:ring-offset-bg-surface';
---

<section id="invite" aria-labelledby="invite-title" class="mt-16 sm:mt-20 scroll-mt-24">
  <div class="rounded-xl bg-surface border border-border p-6 sm:p-8">
    <h2 id="invite-title" class="section-title mb-3">{inv.title}</h2>
    <p class="text-text-secondary mb-8 max-w-[640px]">
      {ledeBefore}<a href={mailto} class={`font-mono text-text-primary underline decoration-border underline-offset-4 hover:text-brand-primary-hover hover:decoration-brand-primary transition-colors rounded [overflow-wrap:anywhere] ${focusRing}`}>{contactEmail}</a>{ledeAfter}
    </p>

    <dl data-invite-details class="grid gap-8 md:grid-cols-[1.6fr_1fr] m-0">
      <div>
        <dt class={labelClass}>{inv.topics_title}</dt>
        <dd class="m-0">
          <ul class="list-none p-0 m-0 flex flex-col gap-2.5">
            {inv.topics.map((topic) => (
              <li class="flex gap-3 font-body text-[15px] leading-relaxed text-text-primary">
                <span class="text-brand-primary" aria-hidden="true">→</span>
                <span>{topic}</span>
              </li>
            ))}
          </ul>
        </dd>
      </div>
      <div class="flex flex-col gap-6">
        <div>
          <dt class={labelClass}>{inv.formats_title}</dt>
          <dd class="m-0">
            <ul class="list-none p-0 m-0 flex flex-wrap gap-2">
              {inv.formats.map((format) => <li class={pillClass}>{format}</li>)}
            </ul>
          </dd>
        </div>
        <div>
          <dt class={labelClass}>{inv.languages_title}</dt>
          <dd class="m-0">
            <ul class="list-none p-0 m-0 flex flex-wrap gap-2">
              {inv.languages.map((language) => <li class={pillClass}>{language}</li>)}
            </ul>
          </dd>
        </div>
      </div>
    </dl>

    <div class="mt-8">
      <a
        href={mailto}
        data-invite-cta
        class={`inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-brand-primary text-bg-base font-body text-[15px] font-medium hover:bg-brand-primary-hover transition-colors ${focusRing}`}
      >
        {inv.cta}
      </a>
    </div>
  </div>

  <div data-speaker-kit class="mt-6 rounded-xl bg-surface border border-border p-6 sm:p-8">
    <h3 class="font-display text-xl font-semibold text-text-primary m-0 mb-1">{inv.kit_title}</h3>
    <p class="text-sm text-text-secondary m-0 mb-6">{inv.kit_intro}</p>

    <div class="grid gap-8 lg:grid-cols-[160px_1fr]">
      <!-- The photo keeps its size; on narrow phones the download button wraps under it. -->
      <div class="flex flex-row flex-wrap items-end gap-4 lg:flex-col lg:items-start">
        <img
          src={speakerPhoto.src640}
          alt={i.about.photo_alt}
          width={speakerPhoto.width}
          height={speakerPhoto.height}
          loading="lazy"
          decoding="async"
          class="block w-24 lg:w-40 h-auto shrink-0 rounded-xl border border-border"
        />
        <a
          href={speakerPhoto.download}
          download="viktor-vedmich-speaker.jpg"
          data-kit-photo
          class={`inline-flex items-center gap-2 px-3.5 py-2 rounded-lg border border-border hover:border-brand-primary hover:text-brand-primary-hover text-text-primary font-body text-[15px] font-medium whitespace-nowrap transition-colors ${focusRing}`}
        >
          <svg class="w-4 h-4" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v11m0 0l-4-4m4 4l4-4M5 20h14" />
          </svg>
          {inv.download_photo}
        </a>
      </div>

      <div class="grid gap-x-8 gap-y-6 md:grid-flow-col md:grid-rows-[auto_auto] min-w-0">
        {bioLangs.flatMap(({ lang, language, bios }) =>
          bios.map(({ id, words, text }) => {
            const heading = `${words} · ${language}`;
            return (
              <div data-bio-card class="min-w-0 rounded-lg border border-border bg-bg-base p-4">
                <div class="flex items-center justify-between gap-3 mb-2">
                  <span class="font-mono text-xs text-text-secondary">{heading}</span>
                  <button
                    type="button"
                    hidden
                    data-copy-bio={id}
                    data-label={inv.copy}
                    data-label-done={inv.copied}
                    data-done={inv.copy_done.replace('{words}', words).replace('{language}', language)}
                    data-failed={inv.copy_failed}
                    aria-label={inv.copy_label.replace('{words}', words).replace('{language}', language)}
                    class={`inline-flex items-center px-3 py-1 min-h-8 rounded-md border border-border hover:border-brand-primary hover:text-brand-primary-hover text-text-primary font-body text-[13px] font-medium transition-colors cursor-pointer ${focusRing}`}
                  >
                    {inv.copy}
                  </button>
                </div>
                <p id={id} lang={lang} class="font-body text-[15px] leading-relaxed text-text-secondary m-0">{text}</p>
              </div>
            );
          }),
        )}
      </div>
    </div>

    {/* Live region exists from page load so the result of Copy is announced; it is also visible feedback. */}
    <p data-kit-status role="status" aria-live="polite" class="font-mono text-xs text-brand-primary mt-4 mb-0 min-h-[1.25rem]"></p>
  </div>
</section>

<script>
  const kit = document.querySelector<HTMLElement>('[data-speaker-kit]');
  const status = kit?.querySelector<HTMLElement>('[data-kit-status]');
  const buttons = kit ? Array.from(kit.querySelectorAll<HTMLButtonElement>('[data-copy-bio]')) : [];

  if (kit && status && buttons.length > 0) {
    let statusTimer: number | undefined;
    const labelTimers = new Map<HTMLButtonElement, number>();

    // Empty first, then fill: pressing the same button again announces the message again.
    function announce(message: string): void {
      window.clearTimeout(statusTimer);
      status!.textContent = '';
      window.setTimeout(() => {
        status!.textContent = message;
      }, 50);
      statusTimer = window.setTimeout(() => {
        status!.textContent = '';
      }, 5000);
    }

    // Clipboard API first, then a hidden-textarea fallback for older browsers and insecure contexts.
    async function copyViaClipboardApi(text: string): Promise<boolean> {
      if (!navigator.clipboard || !window.isSecureContext) return false;
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        return false;
      }
    }

    function copyViaSelection(text: string): boolean {
      const helper = document.createElement('textarea');
      helper.value = text;
      helper.setAttribute('readonly', '');
      helper.setAttribute('aria-hidden', 'true');
      helper.style.position = 'fixed';
      helper.style.top = '0';
      helper.style.left = '0';
      helper.style.opacity = '0';
      document.body.appendChild(helper);
      helper.select();
      helper.setSelectionRange(0, helper.value.length);
      let ok = false;
      try {
        ok = document.execCommand('copy');
      } catch {
        ok = false;
      }
      document.body.removeChild(helper);
      return ok;
    }

    function selectText(element: HTMLElement): void {
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      range.selectNodeContents(element);
      selection.removeAllRanges();
      selection.addRange(range);
    }

    for (const button of buttons) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        const source = document.getElementById(button.dataset.copyBio ?? '');
        const text = source?.textContent?.trim() ?? '';
        if (!source || !text) return;
        const ok = (await copyViaClipboardApi(text)) || copyViaSelection(text);
        button.focus();
        if (ok) {
          announce(button.dataset.done ?? '');
          // Visible feedback on the button itself: the status line can be far away on a phone.
          button.textContent = button.dataset.labelDone ?? '';
          window.clearTimeout(labelTimers.get(button));
          labelTimers.set(
            button,
            window.setTimeout(() => {
              button.textContent = button.dataset.label ?? '';
            }, 2000),
          );
        } else {
          selectText(source);
          announce(button.dataset.failed ?? '');
        }
      });
    }
  }
</script>

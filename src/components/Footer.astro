---
import { t, type Locale } from '../i18n/utils';
import { contactEmail } from '../data/social';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const i = t(locale);
const year = new Date().getFullYear();

const linkClass =
  'underline decoration-border underline-offset-4 hover:text-brand-primary-hover hover:decoration-brand-primary transition-colors';
---

<footer class="border-t border-border">
  <div class="section-container py-8 text-[13px] text-text-muted">
    {/* Separators show from the sm breakpoint. On phones the items wrap on their own, so a dot never dangles at a line end. */}
    <p class="m-0 flex flex-wrap items-center gap-x-4 gap-y-1 sm:gap-x-2.5">
      <span>{i.footer.copyright.replace('{year}', String(year))}</span>
      <span aria-hidden="true" class="hidden sm:inline">·</span>
      <span>{i.footer.opinions}</span>
      <span aria-hidden="true" class="hidden sm:inline">·</span>
      <a href={`/${locale}/rss.xml`} class={linkClass}>{i.footer.rss}</a>
      <span aria-hidden="true" class="hidden sm:inline">·</span>
      <a href={`mailto:${contactEmail}`} class={linkClass}>{contactEmail}</a>
    </p>
  </div>
</footer>
